// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/5/Memory.hdl
/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load=1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid. Access to any address in 
 * the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the Screen
 * and Keyboard chip specifications given in the lectures and the book.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
	 // Determine which memory device to use
    

    // RAM16K uses addresses 0x0000 - 0x3FFF.
    // These addresses all have address[14] = 0.
    Not(in=address[14], out=ramSelect);

    // Screen uses addresses 0x4000 - 0x5FFF.
    // These addresses have:
    // address[14] = 1
    // address[13] = 0
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=screenSelect);

    // Keyboard is at address 0x6000.
    // 0x6000 = 110000000000000
    //
    // Therefore address[14] and address[13] must be 1,
    // while every other address bit must be 0.

    And(a=address[14], b=address[13], out=keyboardHigh);

    Not(in=address[12], out=notA12);
    Not(in=address[11], out=notA11);
    Not(in=address[10], out=notA10);
    Not(in=address[9], out=notA9);
    Not(in=address[8], out=notA8);
    Not(in=address[7], out=notA7);
    Not(in=address[6], out=notA6);
    Not(in=address[5], out=notA5);
    Not(in=address[4], out=notA4);
    Not(in=address[3], out=notA3);
    Not(in=address[2], out=notA2);
    Not(in=address[1], out=notA1);
    Not(in=address[0], out=notA0);

    // Combine the zero bits to determine whether
    // the address is exactly 0x6000.

    And(a=notA12, b=notA11, out=k1);
    And(a=notA10, b=notA9, out=k2);
    And(a=notA8, b=notA7, out=k3);
    And(a=notA6, b=notA5, out=k4);
    And(a=notA4, b=notA3, out=k5);
    And(a=notA2, b=notA1, out=k6);

    And(a=k1, b=k2, out=k7);
    And(a=k3, b=k4, out=k8);
    And(a=k5, b=k6, out=k9);

    And(a=k7, b=k8, out=k10);
    And(a=k9, b=notA0, out=k11);

    And(a=k10, b=k11, out=keyboardLow);

    And(a=keyboardHigh, b=keyboardLow, out=keyboardSelect);


    // -----------------------------------
    // Generate the load signals
    // -----------------------------------

    // RAM gets load only when RAM is selected.
    And(a=load, b=ramSelect, out=ramLoad);

    // Screen gets load only when Screen is selected.
    And(a=load, b=screenSelect, out=screenLoad);

    // Keyboard is read-only, so we don't need a keyboard load signal.


    // -----------------------------------
    // Connect the memory chips
    // -----------------------------------

    RAM16K(
        in=in,
        load=ramLoad,
        address=address[0..13],
        out=ramOut
    );

    Screen(
        in=in,
        load=screenLoad,
        address=address[0..12],
        out=screenOut
    );

    Keyboard(
        out=keyboardOut
    );


    // -----------------------------------
    // Select the correct output
    // -----------------------------------

    // First choose between RAM and Screen.
    // screenSelect = 0 -> RAM
    // screenSelect = 1 -> Screen

    Mux16(
        a=ramOut,
        b=screenOut,
        sel=screenSelect,
        out=ramOrScreen
    );

    // Then choose between RAM/Screen and Keyboard.
    // keyboardSelect = 0 -> RAM/Screen
    // keyboardSelect = 1 -> Keyboard

    Mux16(
        a=ramOrScreen,
        b=keyboardOut,
        sel=keyboardSelect,
        out=out
    );
}
}
